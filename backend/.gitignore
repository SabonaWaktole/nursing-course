node_modules
# Keep environment variables out of version control
.env

/generated/prisma
old_db_backup/*
*.txt
*.log
*.pdf
*.zip

uploads/*
old_db_backup/*
*.sql
# ...but Prisma migrations are source, not dumps. Without this the four existing
# migrations stay tracked (they predate the rule) while every new one is silently
# dropped from commits and never reaches production.
!prisma/migrations/**/*.sql
